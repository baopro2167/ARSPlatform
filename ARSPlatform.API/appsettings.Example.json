{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=ARSFlatformDb;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=False;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY",
    "Issuer": "ARSPlatform",
    "Audience": "ARSPlatformUsers",
    "ExpireMinutes": 1440
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "arsplatform.contact@gmail.com",
    "SenderName": "ARS Platform System",
    "SenderPassword": "YOUR_EMAIL_PASSWORD",
    "EnableSsl": true,
    "VerificationUrl": "http://localhost:5173/verify-email"
  },
  "GeminiSettings": {
    "ApiKey": "YOUR_GEMINI_API_KEY",
    "Model": "gemini-1.5-flash",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta"
  },
  "GoogleMeetSettings": {
    "ClientId": "YOUR_GOOGLE_MEET_CLIENT_ID",
    "ClientSecret": "YOUR_GOOGLE_MEET_CLIENT_SECRET",
    "RefreshToken": "YOUR_GOOGLE_MEET_REFRESH_TOKEN"
  },
  "GoogleAuthSettings": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
  },
  "GoogleCalendar": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET",
    "ServiceAccountEmail": "YOUR_SERVICE_ACCOUNT_EMAIL",
    "PrivateKey": "-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"
  },
  "PayOSSettings": {
    "ClientId": "YOUR_PAYOS_CLIENT_ID",
    "ApiKey": "YOUR_PAYOS_API_KEY",
    "ChecksumKey": "YOUR_PAYOS_CHECKSUM_KEY",
    "BaseUrl": "https://api-merchant.payos.vn",
    "ReturnUrl": "http://localhost:5173/payment/success",
    "CancelUrl": "http://localhost:5173/payment/cancel"
  }
}
